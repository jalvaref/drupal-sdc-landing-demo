<?php

use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\NodeType;

/**
 * Creates the landing content type used by the agent import flow.
 */
function sdc_agent_install(): void {
  sdc_agent_ensure_landing_type();
}

/**
 * Ensures the landing type exists after an update or a reinstatement.
 */
function sdc_agent_update_10001(): void {
  sdc_agent_ensure_landing_type();
}

/**
 * Adds the stable execution key used to update an existing draft idempotently.
 */
function sdc_agent_update_10002(): void {
  sdc_agent_ensure_run_id_field();
}

/**
 * Creates the minimal fields and displays required by the POC.
 */
function sdc_agent_ensure_landing_type(): void {
  $nodeTypeStorage = \Drupal::entityTypeManager()->getStorage('node_type');
  if (!$nodeTypeStorage->load('landing')) {
    NodeType::create([
      'type' => 'landing',
      'name' => 'Landing generada por agente',
      'description' => 'Landing importada desde una propuesta aprobada del agente SDC.',
      'display_submitted' => FALSE,
    ])->save();
  }

  if (!FieldStorageConfig::loadByName('node', 'body')) {
    FieldStorageConfig::create([
      'field_name' => 'body',
      'entity_type' => 'node',
      'type' => 'text_with_summary',
      'cardinality' => 1,
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'landing', 'body')) {
    FieldConfig::create([
      'field_name' => 'body',
      'entity_type' => 'node',
      'bundle' => 'landing',
      'label' => 'Contenido de la landing',
      'required' => FALSE,
    ])->save();
  }
  sdc_agent_ensure_run_id_field();

  $formDisplayStorage = \Drupal::entityTypeManager()->getStorage('entity_form_display');
  if (!$formDisplayStorage->load('node.landing.default')) {
    $formDisplayStorage->create([
      'targetEntityType' => 'node',
      'bundle' => 'landing',
      'mode' => 'default',
      'status' => TRUE,
    ])->setComponent('body', [
      'type' => 'text_textarea_with_summary',
      'weight' => 1,
    ])->save();
  }
  $viewDisplayStorage = \Drupal::entityTypeManager()->getStorage('entity_view_display');
  if (!$viewDisplayStorage->load('node.landing.default')) {
    $viewDisplayStorage->create([
      'targetEntityType' => 'node',
      'bundle' => 'landing',
      'mode' => 'default',
      'status' => TRUE,
    ])->setComponent('body', [
      'type' => 'text_default',
      'label' => 'hidden',
      'weight' => 0,
    ])->save();
  }
  $formDisplay = $formDisplayStorage->load('node.landing.default');
  if ($formDisplay && $formDisplay->getComponent('field_agent_run_id') === NULL) {
    $formDisplay->setComponent('field_agent_run_id', [
      'type' => 'string_textfield',
      'weight' => 2,
    ])->save();
  }
  $viewDisplay = $viewDisplayStorage->load('node.landing.default');
  if ($viewDisplay && $viewDisplay->getComponent('field_agent_run_id') === NULL) {
    $viewDisplay->setComponent('field_agent_run_id', [
      'label' => 'hidden',
      'type' => 'string',
      'weight' => 10,
    ])->save();
  }
}

/**
 * Ensures each imported landing has an idempotency key from the agent run.
 */
function sdc_agent_ensure_run_id_field(): void {
  if (!FieldStorageConfig::loadByName('node', 'field_agent_run_id')) {
    FieldStorageConfig::create([
      'field_name' => 'field_agent_run_id',
      'entity_type' => 'node',
      'type' => 'string',
      'cardinality' => 1,
      'settings' => ['max_length' => 255],
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'landing', 'field_agent_run_id')) {
    FieldConfig::create([
      'field_name' => 'field_agent_run_id',
      'entity_type' => 'node',
      'bundle' => 'landing',
      'label' => 'Agent run ID',
      'required' => FALSE,
    ])->save();
  }
}
