<section class="sdc-section sdc-steps" aria-labelledby="steps-title"><div class="landing-container">{% if title %}<div class="sdc-section__intro"><h2 id="steps-title">{{ title }}</h2>{% if description %}<p>{{ description }}</p>{% endif %}</div>{% endif %}<ol class="sdc-steps__list">{% for item in items %}<li><span class="sdc-step__number">{{ loop.index }}</span><span class="sdc-step__icon" aria-hidden="true"><svg viewBox="0 0 64 64" focusable="false"><circle cx="32" cy="32" r="24" fill="none" stroke="currentColor" stroke-width="3"/><path d="M20 34l8 8 16-18" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span><div><h3>{{ item.title }}</h3><p>{{ item.text }}</p></div></li>{% endfor %}</ol></div></section>
