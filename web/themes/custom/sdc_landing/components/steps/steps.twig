<section class="sdc-section sdc-steps" aria-labelledby="steps-title"><div class="landing-container">{% if title %}<div class="sdc-section__intro"><h2 id="steps-title">{{ title }}</h2>{% if description %}<p>{{ description }}</p>{% endif %}</div>{% endif %}<ol class="sdc-steps__list">{% for i in 1..4 %}{% set step_title = attribute(_context, 'step_' ~ i ~ '_title') %}{% set step_text = attribute(_context, 'step_' ~ i ~ '_text') %}{% set step_icon = attribute(_context, 'step_' ~ i ~ '_icon') %}{% if step_title or step_text %}<li><span class="sdc-step__number">{{ i }}</span><span class="sdc-step__icon sdc-step__icon--{{ step_icon|default('default') }}" aria-hidden="true"><svg viewBox="0 0 64 64" focusable="false"><circle cx="32" cy="32" r="24" fill="none" stroke="currentColor" stroke-width="3"/><path d="M20 34l8 8 16-18" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span><div><h3>{{ step_title }}</h3><p>{{ step_text }}</p></div></li>{% endif %}{% endfor %}</ol></div></section>
