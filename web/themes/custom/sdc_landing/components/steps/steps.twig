<section class="sdc-section sdc-steps" aria-labelledby="steps-title"><div class="landing-container">{% if title %}<div class="sdc-section__intro"><h2 id="steps-title">{{ title }}</h2>{% if description %}<p>{{ description }}</p>{% endif %}</div>{% endif %}<ol class="sdc-steps__list">{% for item in items %}<li><span class="sdc-step__number">{{ loop.index }}</span><div><h3>{{ item.title }}</h3><p>{{ item.text }}</p></div></li>{% endfor %}</ol></div></section>
