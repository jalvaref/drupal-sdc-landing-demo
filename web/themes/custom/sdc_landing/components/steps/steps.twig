<section class="sdc-section sdc-steps" aria-labelledby="steps-title"><div class="landing-container">{% if title %}<div class="sdc-section__intro"><h2 id="steps-title">{{ title }}</h2>{% if description %}<p>{{ description }}</p>{% endif %}</div>{% endif %}<ol class="sdc-steps__list">{% for i in 1..3 %}{% set step_title = attribute(_context, 'step_' ~ i ~ '_title') %}{% set step_text = attribute(_context, 'step_' ~ i ~ '_text') %}{% if step_title or step_text %}<li><span class="sdc-step__number">{{ '%02d'|format(i) }}</span><div><h3>{{ step_title }}</h3><p>{{ step_text }}</p></div></li>{% endif %}{% endfor %}</ol></div></section>
