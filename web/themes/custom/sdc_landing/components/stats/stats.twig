<section class="sdc-stats" aria-label="{{ title|default('Datos destacados') }}"><div class="landing-container">{% if title %}<h2>{{ title }}</h2>{% endif %}<div class="sdc-stats__grid">{% for item in items %}<div class="sdc-stat"><strong>{{ item.value }}</strong><span>{{ item.label }}</span>{% if item.context %}<small>{{ item.context }}</small>{% endif %}</div>{% endfor %}</div>{% if description %}<p class="sdc-stats__note">{{ description }}</p>{% endif %}</div></section>
