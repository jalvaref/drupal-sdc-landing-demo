<section class="sdc-stats" aria-label="{{ title|default('Datos destacados') }}"><div class="landing-container"><div class="sdc-stats__intro">{% if title %}<h2>{{ title }}</h2>{% endif %}{% if description %}<p>{{ description }}</p>{% endif %}</div><div class="sdc-stats__grid">{% for i in 1..3 %}{% set value = attribute(_context, 'stat_' ~ i ~ '_value') %}{% set label = attribute(_context, 'stat_' ~ i ~ '_label') %}{% set context = attribute(_context, 'stat_' ~ i ~ '_context') %}{% if value or label %}<div class="sdc-stat"><strong>{{ value }}</strong><span>{{ label }}</span>{% if context %}<small>{{ context }}</small>{% endif %}</div>{% endif %}{% endfor %}</div></div></section>
