<section class="sdc-hero sdc-hero--{{ variant|default('split') }} sdc-hero--{{ theme|default('light') }}" aria-labelledby="{{ title|clean_class }}">
  <div class="landing-container sdc-hero__inner">
    <div class="sdc-hero__content">{% if eyebrow %}<p class="sdc-kicker">{{ eyebrow }}</p>{% endif %}<h1 id="{{ title|clean_class }}">{{ title }}</h1>{% if description %}<p class="sdc-hero__description">{{ description }}</p>{% endif %}<div class="sdc-actions">{% if primary_cta.label %}<a class="button button--primary" href="{{ primary_cta.url }}">{{ primary_cta.label }} <span aria-hidden="true">→</span></a>{% endif %}{% if secondary_cta.label %}<a class="button button--text" href="{{ secondary_cta.url }}">{{ secondary_cta.label }} <span aria-hidden="true">→</span></a>{% endif %}</div></div>
    {% if image.src %}<div class="sdc-hero__media"><img src="{{ image.src }}" alt="{{ image.alt }}" loading="eager"></div>{% endif %}
  </div>
</section>
