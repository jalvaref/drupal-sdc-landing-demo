<section class="sdc-section sdc-feature-grid sdc-feature-grid--{{ theme|default('light') }}" aria-labelledby="feature-grid-title"><div class="landing-container">{% if title %}<div class="sdc-section__intro"><h2 id="feature-grid-title">{{ title }}</h2>{% if description %}<p>{{ description }}</p>{% endif %}</div>{% endif %}<div class="sdc-grid sdc-grid--{{ columns|default(3) }}">{% for i in 1..3 %}{% set icon = attribute(_context, 'item_' ~ i ~ '_icon') %}{% set item_title = attribute(_context, 'item_' ~ i ~ '_title') %}{% set item_text = attribute(_context, 'item_' ~ i ~ '_text') %}{% if item_title or item_text %}<article class="sdc-feature"><span class="sdc-feature__icon sdc-feature__icon--{{ icon|default('spark') }}" aria-hidden="true"><svg viewBox="0 0 64 64" focusable="false"><path d="M12 50h40M17 44V25h30v19M22 25v-8h20v8M25 44V31M39 44V31" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><path d="M12 25l20-12 20 12" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/></svg></span><h3>{{ item_title }}</h3><p>{{ item_text }}</p></article>{% endif %}{% endfor %}</div></div></section>
