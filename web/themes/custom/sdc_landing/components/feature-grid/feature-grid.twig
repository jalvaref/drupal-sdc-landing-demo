<section class="sdc-section sdc-feature-grid sdc-feature-grid--{{ theme|default('light') }}" aria-labelledby="feature-grid-title"><div class="landing-container">{% if title %}<div class="sdc-section__intro"><p class="sdc-kicker">Capacidades</p><h2 id="feature-grid-title">{{ title }}</h2>{% if description %}<p>{{ description }}</p>{% endif %}</div>{% endif %}<div class="sdc-grid sdc-grid--{{ columns|default(3) }}">{% for item in items %}<article class="sdc-feature"><span class="sdc-feature__icon" aria-hidden="true">{{ item.icon|default('✦') }}</span><h3>{{ item.title }}</h3><p>{{ item.text }}</p></article>{% endfor %}</div></div></section>
