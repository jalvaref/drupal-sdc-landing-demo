<section class="sdc-section sdc-feature-grid sdc-feature-grid--{{ theme|default('light') }}" aria-labelledby="feature-grid-title"><div class="landing-container">{% if title %}<div class="sdc-section__intro"><h2 id="feature-grid-title">{{ title }}</h2>{% if description %}<p>{{ description }}</p>{% endif %}</div>{% endif %}<div class="sdc-grid sdc-grid--{{ columns|default(3) }}">{% for item in items %}<article class="sdc-feature"><span class="sdc-feature__icon sdc-feature__icon--{{ item.icon|default('spark') }}" aria-hidden="true"><svg viewBox="0 0 64 64" focusable="false">{% if item.icon == 'security' %}<path d="M32 7l20 7v15c0 13-8 23-20 28C20 52 12 42 12 29V14l20-7zM32 22a6 6 0 0 0-6 6v4h12v-4a6 6 0 0 0-6-6zm-9 10h18v14H23z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><circle cx="32" cy="39" r="2" fill="currentColor"/>{% elseif item.icon == 'scale' %}<path d="M12 48h40M18 42V34M27 42V28M36 42V21M45 42V14M13 24c10 0 17-4 25-13l12-4" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M43 7h8v8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>{% else %}<path d="M12 50h40M17 44V25h30v19M22 25v-8h20v8M25 44V31M39 44V31" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><path d="M12 25l20-12 20 12" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>{% endif %}</svg></span><h3>{{ item.title }}</h3><p>{{ item.text }}</p></article>{% endfor %}</div></div></section>
