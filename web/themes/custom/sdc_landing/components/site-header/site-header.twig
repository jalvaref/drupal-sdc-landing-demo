<header class="site-header">
  <div class="landing-container site-header__inner">
    <a class="site-header__brand" href="{{ brand_url|default('/') }}" aria-label="{{ brand_name }} · inicio">{{ brand_name }}</a>
    <nav class="site-header__nav" aria-label="Utilidades">
      <a href="{{ utility_url|default('#offers-title') }}">{{ utility_label }}</a>
      <a href="{{ phone_url|default('tel:900000000') }}">{{ phone_label }}</a>
    </nav>
  </div>
</header>
