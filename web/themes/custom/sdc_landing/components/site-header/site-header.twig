<header class="site-header site-header--{{ variant|default('standard') }}">
  <div class="landing-container site-header__inner">
    <a class="site-header__brand" href="{{ brand_url|default('/') }}" aria-label="{{ brand_name }} · inicio"><span class="sdc-mark" aria-hidden="true"></span><span>{{ brand_name }}</span></a>
    <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="site-header-navigation">
      <span class="visually-hidden">Abrir menú</span><span aria-hidden="true">☰</span>
    </button>
    <nav id="site-header-navigation" class="site-header__nav" aria-label="Navegación principal">
      {% for item in navigation %}<a{% if item.active %} aria-current="page"{% endif %} href="{{ item.url }}">{{ item.label }}</a>{% endfor %}
      {% if primary_cta.label %}<a class="button button--outline" href="{{ primary_cta.url }}">{{ primary_cta.label }}</a>{% endif %}
    </nav>
  </div>
</header>
