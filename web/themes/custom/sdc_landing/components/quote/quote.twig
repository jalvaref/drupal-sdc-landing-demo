<figure class="sdc-quote sdc-quote--{{ variant|default('highlighted') }}">{% if image.src %}<img src="{{ image.src }}" alt="{{ image.alt|default('') }}">{% endif %}<blockquote>“{{ quote }}”</blockquote>{% if author %}<figcaption><strong>{{ author }}</strong>{% if role %}<span> · {{ role }}</span>{% endif %}{% if organization %}<span> · {{ organization }}</span>{% endif %}</figcaption>{% endif %}</figure>
