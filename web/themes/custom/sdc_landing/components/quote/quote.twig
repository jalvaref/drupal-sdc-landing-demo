<figure class="sdc-quote sdc-quote--{{ variant|default('highlighted') }} sdc-visual-quote">{% if image.src %}<img src="{{ image.src }}" alt="{{ image.alt|default('') }}">{% endif %}<div class="sdc-quote__content"><span class="sdc-quote__mark" aria-hidden="true">“</span><blockquote>{{ quote }}</blockquote>{% if author %}<figcaption><strong>{{ author }}</strong>{% if role %}<span> · {{ role }}</span>{% endif %}{% if organization %}<span> · {{ organization }}</span>{% endif %}</figcaption>{% endif %}</div></figure>
