<section class="sdc-cta sdc-cta--{{ theme|default('dark') }}"><div class="landing-container sdc-cta__inner"><div>{% if eyebrow %}<p class="sdc-kicker">{{ eyebrow }}</p>{% endif %}<h2>{{ title }}</h2>{% if description %}<p>{{ description }}</p>{% endif %}<div class="sdc-actions"><a class="button button--primary" href="{{ primary_cta.url }}">{{ primary_cta.label }} <span aria-hidden="true">→</span></a>{% if secondary_cta.label %}<a class="button button--light" href="{{ secondary_cta.url }}">{{ secondary_cta.label }}</a>{% endif %}</div></div>{% if image.src %}<img src="{{ image.src }}" alt="{{ image.alt|default('') }}" loading="lazy">{% endif %}</div></section>
