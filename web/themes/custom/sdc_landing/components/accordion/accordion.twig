<section class="sdc-section sdc-accordion" aria-labelledby="accordion-title"><div class="landing-container">{% if title %}<h2 id="accordion-title">{{ title }}</h2>{% endif %}<div class="sdc-accordion__items">{% for i in 1..4 %}{% set question = attribute(_context, 'question_' ~ i) %}{% set answer = attribute(_context, 'answer_' ~ i) %}{% if question or answer %}<details{% if default_open == 0 and i == 1 %} open{% endif %}><summary>{{ question }}<span aria-hidden="true">+</span></summary><div class="sdc-accordion__answer">{{ answer|raw }}</div></details>{% endif %}{% endfor %}</div></div></section>
