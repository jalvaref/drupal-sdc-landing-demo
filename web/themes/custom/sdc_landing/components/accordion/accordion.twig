<section class="sdc-section sdc-accordion" aria-labelledby="accordion-title"><div class="landing-container">{% if title %}<h2 id="accordion-title">{{ title }}</h2>{% endif %}<div class="sdc-accordion__items">{% for item in items %}<details{% if default_open == 0 and loop.first %} open{% endif %}><summary>{{ item.question }}<span aria-hidden="true">+</span></summary><div class="sdc-accordion__answer">{{ item.answer|raw }}</div></details>{% endfor %}</div></div></section>
