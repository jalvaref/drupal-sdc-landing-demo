<footer class="site-footer">
  <div class="landing-container site-footer__grid">
    {% if logo.label %}<a class="site-footer__logo" href="{{ logo.url|default('/') }}">{{ logo.label }}</a>{% endif %}
    {% for column in columns %}<div class="site-footer__column"><h2>{{ column.title }}</h2><ul>{% for link in column.links %}<li><a href="{{ link.url }}">{{ link.label }}</a></li>{% endfor %}</ul></div>{% endfor %}
  </div>
  <div class="landing-container site-footer__bottom"><nav aria-label="Enlaces legales"><ul>{% for link in legal_links %}<li><a href="{{ link.url }}">{{ link.label }}</a></li>{% endfor %}</ul></nav><p>{{ copyright }}</p></div>
</footer>
