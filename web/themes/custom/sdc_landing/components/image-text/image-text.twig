{% set resolved_image_src = image_src|replace({'preview/hero-energy.jpg': '/themes/custom/sdc_landing/assets/hero-energy.jpg', 'preview/': '/themes/custom/sdc_landing/images/'}) %}<section class="sdc-image-text sdc-image-text--{{ image_position|default('left') }} sdc-image-text--{{ theme|default('light') }} sdc-visual-image-text"><div class="landing-container sdc-image-text__inner">{% if resolved_image_src %}<figure class="sdc-image-text__media"><img src="{{ resolved_image_src }}" alt="{{ image_alt|default('') }}" loading="lazy"></figure>{% else %}<div class="sdc-image-text__media" role="img" aria-label="Imagen pendiente de selección"></div>{% endif %}<div class="sdc-image-text__content">{% if eyebrow %}<p class="sdc-kicker">{{ eyebrow }}</p>{% endif %}<h2>{{ title }}</h2>{% if description %}<p>{{ description }}</p>{% endif %}{% if cta_label %}<a class="button button--outline" href="{{ cta_url }}">{{ cta_label }} <span aria-hidden="true">→</span></a>{% endif %}</div></div></section>
