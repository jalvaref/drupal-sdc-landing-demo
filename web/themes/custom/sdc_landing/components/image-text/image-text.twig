<section class="sdc-image-text sdc-image-text--{{ image_position|default('left') }} sdc-image-text--{{ theme|default('light') }}"><div class="landing-container sdc-image-text__inner">{% if image_src %}<div class="sdc-image-text__media"><img src="{{ image_src }}" alt="{{ image_alt|default('') }}" loading="lazy"></div>{% else %}<div class="sdc-image-text__media" role="img" aria-label="Imagen pendiente de selección"></div>{% endif %}<div class="sdc-image-text__content">{% if eyebrow %}<p class="sdc-kicker">{{ eyebrow }}</p>{% endif %}<h2>{{ title }}</h2>{% if description %}<p>{{ description }}</p>{% endif %}{% if cta_label %}<a class="button button--outline" href="{{ cta_url }}">{{ cta_label }} <span aria-hidden="true">→</span></a>{% endif %}</div></div></section>
