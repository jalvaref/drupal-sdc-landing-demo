<section class="sdc-section sdc-card-grid" aria-labelledby="card-grid-title"><div class="landing-container">{% if title %}<div class="sdc-section__intro"><h2 id="card-grid-title">{{ title }}</h2>{% if description %}<p>{{ description }}</p>{% endif %}</div>{% endif %}<div class="sdc-grid sdc-grid--cards">{% for card in cards %}<article class="sdc-card{% if loop.first and variant == 'featured-card' %} sdc-card--featured{% endif %}">{% if card.image.src %}<img src="{{ card.image.src }}" alt="{{ card.image.alt|default('') }}" loading="lazy">{% endif %}<div class="sdc-card__body">{% if card.eyebrow %}<p class="sdc-kicker">{{ card.eyebrow }}</p>{% endif %}<h3>{{ card.title }}</h3>{% if card.text %}<p>{{ card.text }}</p>{% endif %}<a class="sdc-link" href="{{ card.link.url }}">{{ card.link.label }} <span aria-hidden="true">→</span></a></div></article>{% endfor %}</div></div></section>
