<section class="sdc-section sdc-accordion sdc-visual-accordion" aria-labelledby="faq-title"><div class="landing-container">{% if title %}<h2 id="faq-title">{{ title }}</h2>{% endif %}<div class="sdc-accordion__items">{% for item in items %}<details{% if loop.first %} open{% endif %}><summary><span class="sdc-accordion__question">{{ item.question }}</span><span class="sdc-accordion__control" aria-hidden="true">+</span></summary><div class="sdc-accordion__answer">{{ item.answer|raw }}</div></details>{% endfor %}</div></div></section>
