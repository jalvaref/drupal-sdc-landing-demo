{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdc-landing-demo.local/schemas/brief.schema.json",
  "title": "Landing campaign brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["campaign_name", "objective", "audience", "offer", "ctas"],
  "properties": {
    "campaign_name": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "objective": { "type": "string", "minLength": 1 },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "age_range": { "type": "string" },
        "location": { "type": "string" },
        "needs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "price": { "type": "string" },
        "conditions": { "type": "array", "items": { "type": "string" } },
        "benefits": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ctas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "goal"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "goal": { "type": "string", "minLength": 1 },
          "priority": { "type": "string", "enum": ["primary", "secondary", "informational"] }
        }
      }
    },
    "kpis": { "type": "array", "items": { "type": "string" } },
    "duration": { "type": "string" },
    "brand_guidance": { "type": "array", "items": { "type": "string" } },
    "assets": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "candidate_components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "justification"],
        "properties": {
          "id": { "type": "string", "pattern": "^C[0-9]{2}$" },
          "name": { "type": "string", "minLength": 1 },
          "variant": { "type": "string", "default": "Experimental" },
          "justification": { "type": "string", "minLength": 1 },
          "props": { "type": "object" }
        }
      }
    },
    "content_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_fictional_content": { "type": "boolean", "default": true },
        "tone": { "type": "string", "default": "professional" }
      }
    }
  }
}
