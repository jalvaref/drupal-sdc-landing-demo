{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdc-landing-demo.local/schemas/landing-proposal.schema.json",
  "title": "Governed landing proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "briefing_ref", "status", "components", "assumptions", "open_questions"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "briefing_ref": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["visual_draft", "visual_approved", "html_draft", "html_approved", "sdc_package_draft", "sdc_approved", "drupal_draft"]
    },
    "visuals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["desktop", "mobile"],
      "properties": {
        "desktop": { "type": "string", "description": "Ruta o referencia al diseño desktop." },
        "mobile": { "type": "string", "description": "Ruta o referencia al diseño mobile." }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "variant", "props", "status", "justification"],
        "properties": {
          "component_id": { "type": "string", "pattern": "^C[0-9]{2}$" },
          "variant": { "type": "string" },
          "props": { "type": "object" },
          "status": { "type": "string", "enum": ["catalog", "experimental", "candidate"] },
          "justification": { "type": "string", "minLength": 1 },
          "content_status": { "type": "string", "enum": ["validated", "pending_validation", "blocked"] },
          "source_requirements": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "html_artifact": { "type": "string" },
    "traceability_artifact": { "type": "string" },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approved": { "type": "boolean" },
        "approved_by": { "type": "string" },
        "approved_at": { "type": "string", "format": "date-time" },
        "comment": { "type": "string" }
      }
    }
  }
}
