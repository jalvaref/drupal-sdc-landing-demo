<section class="recommendation-wizard" data-component-id="C12" aria-labelledby="recommendation-wizard-title">
  <h2 id="recommendation-wizard-title">{{ title }}</h2>
  {% if description %}<p class="recommendation-wizard__description">{{ description }}</p>{% endif %}
  <ol class="recommendation-wizard__progress" aria-label="Progreso del recorrido">
    {% for step_number in 1..3 %}<li data-wizard-progress="{{ step_number }}"{% if step_number == 1 %} aria-current="step"{% endif %}>{{ attribute(_context, 'step_' ~ step_number ~ '_label') }}</li>{% endfor %}
    <li data-wizard-progress="result">Resultado</li>
  </ol>
  <form class="recommendation-wizard__form" novalidate>
    {% for step_number in 1..3 %}
      {% set step_type = attribute(_context, 'step_' ~ step_number ~ '_type') %}
      {% set step_field = attribute(_context, 'step_' ~ step_number ~ '_field') %}
      <fieldset data-wizard-step="{{ step_number }}"{% if step_number != 1 %} hidden{% endif %}>
        <legend>{{ attribute(_context, 'step_' ~ step_number ~ '_label') }}</legend>
        {% if step_type == 'select' %}
          <label for="{{ step_field }}">{{ attribute(_context, 'step_' ~ step_number ~ '_label') }}</label>
          <select id="{{ step_field }}" name="{{ step_field }}">
            <option value="">Selecciona una opción</option>
            {% for option_number in 1..3 %}{% set option = attribute(_context, 'step_' ~ step_number ~ '_option_' ~ option_number) %}{% if option %}<option value="{{ option }}">{{ option }}</option>{% endif %}{% endfor %}
          </select>
        {% else %}
          {% for option_number in 1..3 %}{% set option = attribute(_context, 'step_' ~ step_number ~ '_option_' ~ option_number) %}{% if option %}<label><input type="radio" name="{{ step_field }}" value="{{ option }}"> {{ option }}</label>{% endif %}{% endfor %}
        {% endif %}
      </fieldset>
    {% endfor %}
    <p class="recommendation-wizard__error" role="alert" aria-live="assertive"></p>
    <button type="button" data-wizard-back hidden>Volver</button>
    <button type="button" data-wizard-next>Siguiente</button>
  </form>
  <div class="recommendation-wizard__result" data-wizard-result hidden aria-live="polite">
    <h3>{{ result_title }}</h3>
    <p>{{ result_body }}</p>
    <a href="{{ primary_url }}">{{ primary_label }}</a>
  </div>
</section>
